#!/bin/bash

# ensure-server: start the real-time ecFlow server on the ecFlow node if it is not already
# running. The driver runs this over ssh. The server holds a non-blocking flock for its whole
# lifetime, so this does nothing while the server runs, and otherwise starts it, recovering
# suite state from its checkpoint. The server runs in the background, so it survives logout.

set -aeuo pipefail

usage() {
  echo "usage: $0 --rundir DIR --config FILE --port PORT [--platform NAME]" >&2
  exit 2
}

platform=ursa
rundir=
config=
port=

while [[ $# -gt 0 ]]; do
  case "$1" in
  --rundir)
    rundir=$2
    shift 2
    ;;
  --config)
    config=$2
    shift 2
    ;;
  --port)
    port=$2
    shift 2
    ;;
  --platform)
    platform=$2
    shift 2
    ;;
  *) usage ;;
  esac
done

[[ -n $rundir && -n $config && -n $port ]] || usage

# Resolve the clone root from this script's location (<clone>/<install>/bin/ensure-server).
self=$(readlink -f "$0")
install=$(dirname "$(dirname "$self")")
clone=$(dirname "$install")

mkdir -p "$rundir"
cd "$rundir"

server() {
  echo "Starting ecFlow server on $(hostname):$port at $(date -u)" >&2
  # shellcheck source=/dev/null
  source "$clone/bin/activate-$platform"
  uw ecflow server --config-file "$config" --port "$port" --report >server.json
}

run() {
  flock -n server.lock -c server
}

run </dev/null >>server.log 2>&1 &
disown
