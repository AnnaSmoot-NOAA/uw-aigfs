{# Unified crontab for both real-time streams plus the shared report. Written
   once by the rtaigfs-ursa-all umbrella playbook so the two streams and the
   report share a single crontab and never clobber one another. -#}
MAILTO=paul.madden@noaa.gov
PATH={{ rtaigfs_all_crontab_path_env }}
SHELL=/bin/bash

*/5 * * * * {{ rtaigfs_rocoto_bin_dir }}/run
*/5 * * * * ECFLOW_HOST={{ rtaigfs_ecflow_host }} {% if rtaigfs_ecflow_port %}ECFLOW_PORT={{ rtaigfs_ecflow_port }} {% endif %}PLATFORM={{ rtaigfs_ecflow_platform }} {{ rtaigfs_ecflow_bin_dir }}/run
0 15 * * * {{ rtaigfs_report_bin_dir }}/bb {{ rtaigfs_report_bin_dir }}/report
